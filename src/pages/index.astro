---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopicCard from '../components/TopicCard.astro';
import { withBase } from '../lib/url';

const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const categories = [...new Set(topics.map((topic) => topic.data.category))];
---

<Base title="Glassbox" description="Interactive diagrams that open up cloud, AI and developer tooling to show how the parts fit together, one idea at a time.">
  <section class="content-frame home-hero" aria-labelledby="home-title">
    <p class="eyebrow">Glassbox · A living wiki</p>
    <h1 id="home-title">See inside the tools you build with.</h1>
    <p class="home-hero__subtitle">Interactive diagrams that open up cloud, AI and developer tooling to show how the parts fit together, one idea at a time.</p>

    {categories.length > 1 && (
      <div class="home-filters" role="group" aria-label="Filter by category" data-category-filters>
        <button class="chip" type="button" aria-pressed="true" data-filter="">All topics</button>
        {categories.map((category) => (
          <button class="chip" type="button" aria-pressed="false" data-filter={category}>{category}</button>
        ))}
      </div>
    )}

    <div class="topic-grid">
      {topics.map((topic) => (
        <TopicCard
          href={withBase(`/${topic.id}/`)}
          title={topic.data.shortTitle ?? topic.data.title}
          summary={topic.data.summary}
          category={topic.data.category}
          badge={topic.data.badge}
          art={topic.data.art}
        />
      ))}
    </div>
  </section>
</Base>

<script>
  const filters = document.querySelector('[data-category-filters]');
  const buttons = filters ? [...filters.querySelectorAll<HTMLButtonElement>('[data-filter]')] : [];
  const cards = [...document.querySelectorAll<HTMLElement>('.topic-grid [data-category]')];

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const selected = button.dataset.filter ?? '';
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      for (const card of cards) card.hidden = selected !== '' && card.dataset.category !== selected;
    });
  }
</script>

<style>
  .home-hero {
    padding-top: 88px;
  }

  h1 {
    max-width: 980px;
    margin-top: 22px;
    color: var(--text);
    font-size: clamp(2.6rem, 5.6vw, 4.25rem);
    font-weight: 760;
    letter-spacing: -0.038em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .home-hero__subtitle {
    max-width: 920px;
    margin-top: 24px;
    color: var(--muted);
    font-size: clamp(1.06rem, 2vw, 1.35rem);
    line-height: 1.45;
  }

  .home-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 42px;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 64px;
  }

  @media (max-width: 1180px) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .home-hero {
      padding-top: 40px;
    }

    .topic-grid {
      grid-template-columns: 1fr;
      margin-top: 42px;
    }
  }
</style>
