<div class="hierarchy-art" aria-hidden="true">
  <div class="enterprise">
    <span class="bar"></span>
    <div class="orgs">
      <div class="org">
        <span class="chip chip--repo"></span>
        <span class="chip chip--team"></span>
      </div>
      <div class="org">
        <span class="chip chip--repo"></span>
        <span class="chip chip--team"></span>
      </div>
    </div>
  </div>
  <div class="people">
    {Array.from({ length: 3 }).map(() => <span class="person"></span>)}
  </div>
</div>

<style>
  .hierarchy-art {
    width: min(100%, 286px);
    height: 120px;
    display: grid;
    grid-template-columns: 1fr 42px;
    align-items: center;
    gap: 14px;
    padding: 0 16px;
  }

  .enterprise {
    display: grid;
    gap: 7px;
    padding: 8px;
    border: 1.5px solid color-mix(in srgb, var(--accent) 70%, transparent);
    border-radius: 10px;
  }

  .bar {
    display: block;
    width: 46%;
    height: 9px;
    border-radius: 3px;
    background: var(--accent-grad);
  }

  .orgs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 7px;
  }

  .org {
    display: grid;
    gap: 5px;
    padding: 6px;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
  }

  .chip {
    display: block;
    height: 11px;
    border-radius: 3px;
  }

  .chip--repo {
    background: var(--cc-0);
  }

  .chip--team {
    width: 70%;
    background: color-mix(in srgb, var(--cc-1) 80%, transparent);
  }

  .people {
    display: grid;
    gap: 8px;
    justify-items: center;
    padding: 8px 0;
    border-left: 2px dashed var(--border-strong);
  }

  .person {
    position: relative;
    width: 16px;
    height: 20px;
  }

  .person::before,
  .person::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: var(--cc-2);
  }

  .person::before {
    top: 0;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
  }

  .person::after {
    bottom: 0;
    width: 14px;
    height: 9px;
    border-radius: 9px 9px 2px 2px;
  }
</style>
