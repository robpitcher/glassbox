---
import ThemeToggle from './ThemeToggle.svelte';
import { withBase } from '../lib/url';
---

<header class="topbar">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="topbar__inner">
    <button class="hamburger" type="button" aria-label="Open contents" aria-expanded="false" aria-controls="site-sidebar" data-sidebar-toggle>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a class="brand" href={withBase('/')} aria-label="Glassbox home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 28 28"><path d="M14 5.5 21 9.5v9l-7 4-7-4v-9Z M7 9.5l7 4 7-4 M14 13.5v9"></path></svg>
      </span>
      <span>Glassbox</span>
    </a>

    <button class="search-trigger" type="button" data-search-trigger aria-label="Search topics">
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      <span>Search topics…</span>
      <kbd>⌘K</kbd>
    </button>

    <div class="topbar__actions">
      <nav class="topbar__nav" aria-label="Primary">
        <a href={withBase('/')}>Topics</a>
      </nav>

      <ThemeToggle client:load />

      <a class="github-link" href="https://github.com/robpitcher/glassbox" aria-label="Glassbox on GitHub" rel="noreferrer">
        <svg aria-hidden="true" viewBox="0 0 16 16">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  document.querySelector('[data-search-trigger]')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });
</script>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--topbar-h);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(18px);
  }

  .topbar__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 24px;
  }

  .skip-link {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-solid);
    color: var(--text);
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .hamburger {
    display: none;
    width: 38px;
    height: 38px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .hamburger span {
    display: block;
    height: 2px;
    margin: 4px 0;
    border-radius: var(--radius-pill);
    background: var(--text);
  }

  .brand {
    display: inline-flex;
    flex: 0 0 252px;
    align-items: center;
    gap: 12px;
    width: max-content;
    font-size: 1.05rem;
    font-weight: 780;
    letter-spacing: -0.02em;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent-grad);
    color: var(--on-accent);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .brand__mark svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .search-trigger {
    flex: 0 1 420px;
    width: min(420px, 100%);
    height: 36px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 0 10px 0 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-2);
    color: var(--muted);
    text-align: left;
  }

  .search-trigger svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .search-trigger kbd {
    min-width: 34px;
    padding: 2px 6px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
  }

  .topbar__nav {
    display: flex;
    gap: 30px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 650;
  }

  .topbar__nav a:hover {
    color: var(--text);
  }

  .topbar__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .github-link {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
  }

  .github-link:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .github-link svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  @media (max-width: 960px) {
    .topbar__inner {
      gap: 10px;
      padding: 0 14px;
    }

    .hamburger {
      display: block;
    }

    .brand {
      flex: 1 1 auto;
      min-width: 0;
      gap: 10px;
    }

    .search-trigger {
      flex: 0 0 38px;
      width: 38px;
      height: 38px;
      padding: 0;
      place-content: center;
      border-radius: var(--radius-pill);
    }

    .search-trigger span,
    .search-trigger kbd,
    .topbar__nav {
      display: none;
    }

    .topbar__actions {
      margin-left: 0;
      gap: 10px;
    }
  }

  @media (max-width: 480px) {
    .brand span:not(.brand__mark) {
      display: none;
    }
  }
</style>
